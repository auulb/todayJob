# 前程无忧（51job）日报采集配置
#
# 这份文件只被 scripts/job51/* 读取，和智联用的 collect.env 完全独立，
# 改这里不会影响智联日报，反之亦然。

# ── 城市 ────────────────────────────────────────────────────────────────
# 只写城市名，51job 编码由 assets/job51/dd_city.json 在运行时解析。
# 也支持显式写 `厦门:110300`（写了就不再查表）。
# 上限 5 个（太多会拉长运行时间、更容易触发风控）。
JOB51_CITIES=厦门,深圳,上海

# ── 岗位 ────────────────────────────────────────────────────────────────
# 格式：name:profile:关键词1|关键词2|...
#   profile=dev      按"开发岗"规则过滤标题（和智联共用同一套判定规则）
#   profile=keyword  只要求标题包含关键词
#
# 注意：51job 的关键词之间高度重叠（`开发` 已经覆盖大部分结果），
# 实测 37 个关键词只比 3 个多 1 条，但请求数从 3 涨到 38 次、更容易触发风控，
# 所以这里只放 10 个。真想多加，改这行即可（上限 40）。
JOB51_JOBS=开发:dev:开发|Java|前端|后端|Python|Golang|全栈|算法|测试|C++

# ── 上限 / 限速 ─────────────────────────────────────────────────────────
# 留空用默认值：
#   maxCities 3          城市上限
#   maxJobs 3            岗位上限
#   maxKeywordsPerJob 10 每个岗位只用前几个关键词
#   maxPagesPerKeyword 2 每个关键词翻几页（第 1 页已含当天几乎全部结果）
#   maxRequestsPerRun 120 单次运行请求预算（3 城市 × 10 关键词 ≈ 30 次）
#   pageSize 200         每页条数（200 是接口硬上限）
#   issueDate "1"        只取近 1 天（只支持 1/2/3/4）
#   requestDelayMs 3500  请求间隔毫秒（低于 1200 会被拒绝；太快会触发风控）
#   maxTransientFailures 4 连续瞬态失败几次就整体停止
#
# JOB51_LIMITS={"maxCities":3,"maxKeywordsPerJob":10,"maxRequestsPerRun":60}
